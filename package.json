{
  "name": "roomie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "node --test src/features/dashboard/tests/*.test.mjs src/features/expenses/tests/*.test.mjs src/features/household/tests/*.test.mjs src/features/chores/tests/*.test.mjs src/features/members/tests/*.test.mjs src/shared/preferences/tests/*.test.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && playwright test --config playwright.production.config.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
